---
import {
  Coffee,
  MapPin,
  Clock,
  Phone,
  MessageCircle,
  Heart,
  Instagram,
  Facebook,
} from "lucide-astro";
import { siteConfig } from "../config/seo";
---

<footer class="bg-ultra-dark text-white/90 pt-16 pb-12 border-t border-darkest">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Columna 1: Marca & Descripción -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-2xl bg-dark text-white flex items-center justify-center"
          >
            <Coffee class="w-5 h-5" />
          </div>
          <div>
            <span class="font-serif-display font-bold text-xl text-white block">
              Komorebi
            </span>
            <span
              class="text-[10px] uppercase font-semibold text-accent tracking-widest block -mt-1"
            >
              Café & Repostería
            </span>
          </div>
        </div>
        <p class="text-xs text-white/70 leading-relaxed">
          Cafetería boutique de especialidad en CDMX. Pasión por los detalles,
          orden, calidez y una fusión única de café selecto, panadería, postres
          japoneses, crepas y bocadillos salados.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-8 h-8 rounded-full bg-white/10 hover:bg-dark flex items-center justify-center text-white transition-colors"
          >
            <Instagram class="w-4 h-4" />
          </a>
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-8 h-8 rounded-full bg-white/10 hover:bg-dark flex items-center justify-center text-white transition-colors"
          >
            <Facebook class="w-4 h-4" />
          </a>
          <a
            href={`https://wa.me/${siteConfig.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-8 h-8 rounded-full bg-whatsapp hover:bg-whatsapp-dark flex items-center justify-center text-white transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div class="space-y-4">
        <h4
          class="font-serif-display font-bold text-sm text-secondary uppercase tracking-wider"
        >
          Explora
        </h4>
        <ul class="space-y-2.5 text-xs text-white/75">
          <li>
            <a href="#hero" class="hover:text-accent transition-colors"
              >Inicio</a
            >
          </li>
          <li>
            <a href="#esencia" class="hover:text-accent transition-colors"
              >La Esencia</a
            >
          </li>
          <li>
            <a href="#menu" class="hover:text-accent transition-colors"
              >Nuestra Carta</a
            >
          </li>
          <li>
            <a href="#experiencia" class="hover:text-accent transition-colors"
              >Servicios & Modalidades</a
            >
          </li>
          <li>
            <a href="#horarios" class="hover:text-accent transition-colors"
              >Horarios & Ubicación</a
            >
          </li>
          <li>
            <a href="#contacto" class="hover:text-accent transition-colors"
              >Preguntas & Contacto</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 3: Horarios -->
      <div class="space-y-4">
        <h4
          class="font-serif-display font-bold text-sm text-secondary uppercase tracking-wider flex items-center gap-2"
        >
          <Clock class="w-4 h-4 text-dark-accent" />
          <span>Horarios</span>
        </h4>
        <ul class="space-y-2 text-xs text-white/75">
          <li class="flex justify-between pb-1 border-b border-white/10">
            <span>Lunes a Viernes:</span>
            <span class="font-semibold text-white">9:00 - 20:00</span>
          </li>
          <li class="flex justify-between pb-1 border-b border-white/10">
            <span>Sábados:</span>
            <span class="font-semibold text-white">9:00 - 21:00</span>
          </li>
          <li class="flex justify-between pb-1 border-b border-white/10">
            <span>Domingos:</span>
            <span class="font-semibold text-white">11:00 - 17:00</span>
          </li>
        </ul>
        <span class="inline-block text-[11px] text-accent font-medium">
          Consumo en el lugar & Para llevar
        </span>
      </div>

      <!-- Columna 4: Ubicación & Contacto -->
      <div class="space-y-4">
        <h4
          class="font-serif-display font-bold text-sm text-secondary uppercase tracking-wider flex items-center gap-2"
        >
          <MapPin class="w-4 h-4 text-dark-accent" />
          <span>Ubicación</span>
        </h4>
        <p class="text-xs text-white/75 leading-relaxed">
          Av. Insurgentes Sur, Ciudad de México (CDMX), México.
        </p>
        <div class="space-y-1.5 text-xs text-white/75 pt-1">
          <p class="flex items-center gap-2">
            <Phone class="w-3.5 h-3.5 text-accent" />
            <span>+52 55 1234 5678</span>
          </p>
          <p class="flex items-center gap-2">
            <svg
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
              ></path>
            </svg>
            <span>Pedidos vía WhatsApp</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div
      class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 text-center sm:text-left"
    >
      <p>
        © {new Date().getFullYear()} Komorebi Café & Repostería. Todos los derechos
        reservados.
      </p>
      <p class="flex items-center gap-1">
        <span>Hecho con dedicación &</span>
        <Heart class="w-3.5 h-3.5 text-dark-accent fill-dark-accent inline" />
        <span>para los amantes del buen café</span>
      </p>
    </div>
  </div>
</footer>
