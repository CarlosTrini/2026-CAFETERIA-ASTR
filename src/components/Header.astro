---
import { Coffee, Sparkles, MessageCircle } from "lucide-astro";
import { siteConfig } from "../config/seo";

const navLinks = [
  { name: "Inicio", href: "#hero" },
  { name: "La Esencia", href: "#esencia" },
  { name: "Nuestra Carta", href: "#menu" },
  { name: "Experiencia", href: "#experiencia" },
  { name: "Horarios & Ubicación", href: "#horarios" },
  { name: "Contacto", href: "#contacto" },
];
---

<header
  class="w-full sticky top-0 z-50 bg-primary/90 backdrop-blur-md border-b border-accent shadow-xs transition-all duration-300"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between"
  >
    <!-- Brand / Logo -->
    <a href="#hero" class="flex items-center gap-3 group">
      <div
        class="w-10 h-10 rounded-2xl bg-dark text-primary flex items-center justify-center shadow-md shadow-dark/20 group-hover:scale-105 transition-transform duration-200"
      >
        <Coffee class="w-5 h-5" />
      </div>
      <div class="flex flex-col">
        <span
          class="font-serif-display font-bold text-xl sm:text-2xl text-ultra-dark tracking-tight group-hover:text-dark transition-colors"
        >
          Komorebi
        </span>
        <span
          class="text-[10px] font-semibold uppercase tracking-widest text-dark-accent -mt-1"
        >
          Café & Repostería
        </span>
      </div>
    </a>

    <section class="flex gap-4">
      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center gap-4 lg:gap-5 xl:gap-6 text-sm font-medium text-darkest justify-end"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-dark relative py-1 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-dark-accent hover:after:w-full after:transition-all after:duration-200"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Desktop CTA & WhatsApp -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent("¡Hola! Me gustaría hacer un pedido o consultar sobre el menú de Komorebi Café.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-2 lg:px-4 py-2 rounded-full text-xs font-semibold bg-whatsapp hover:bg-whatsapp-dark text-white shadow-xs hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5"
          title="Pedir por whatsapp"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-4 h-4 fill-current"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
            ></path>
          </svg>
          <span class="hidden lg:block">Pedir por WhatsApp</span>
        </a>
      </div>
    </section>

    <!-- Mobile Menu Button  -->
    <div class="flex md:hidden items-center gap-2">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent("¡Hola! Me gustaría hacer un pedido.")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-full bg-whatsapp text-white text-xs flex items-center justify-center shadow-xs"
        aria-label="Pedir por WhatsApp"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-4 h-4 fill-current"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
          ></path>
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2.5 rounded-xl bg-secondary hover:bg-accent text-darkest border border-accent flex items-center gap-1.5 transition-colors focus:outline-none focus:ring-2 focus:ring-dark-accent cursor-pointer"
        aria-label="Abrir Menú de Navegación"
        aria-expanded="false"
      >
        <Coffee id="menu-coffee-icon" class="w-5 h-5 text-dark" />
        <span class="text-xs font-semibold text-ultra-dark">Menú</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu-dropdown"
    class="md:hidden grid-cols-1 h-screen hidden border-b border-accent bg-primary px-4 pt-2 pb-6 space-y-3 shadow-lg transition-all duration-300"
  >
    <div>
      <div
        class="flex items-center justify-between py-2 border-b border-accent/60"
      >
        <div class="flex items-center gap-2 text-xs text-darkest">
          <Sparkles class="w-4 h-4 text-dark-accent" />
          <span>Café & Repostería Artesanal</span>
        </div>
        <div
          class="text-[11px] font-semibold text-dark bg-secondary px-2 py-0.5 rounded-md"
        >
          Insurgentes Sur
        </div>
      </div>

      <div class="flex flex-col space-y-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium text-ultra-dark hover:bg-secondary hover:text-dark transition-colors"
            >
              <span>{link.name}</span>
              <span class="text-xs text-dark-accent">→</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="pt-2">
      <a
        href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent("¡Hola! Me gustaría hacer un pedido.")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold bg-whatsapp text-white shadow-xs"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-4 h-4 fill-current"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
          ></path>
        </svg>
        <span>Escríbenos por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menuDropdown = document.getElementById("mobile-menu-dropdown");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  if (menuBtn && menuDropdown) {
    menuBtn.addEventListener("click", () => {
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      if (!isExpanded) {
        document.body.classList.add("overflow-hidden");
      } else {
        document.body.classList.remove("overflow-hidden");
      }
      menuBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      menuDropdown.classList.toggle("hidden");
      menuDropdown.classList.add("grid");
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menuDropdown.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
        document.body.classList.remove("overflow-hidden");
      });
    });
  }
</script>
