---
/**
 * Plantilla Principal para Komorebi Café & Repostería.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import SEO from "../components/SEO.astro";
import type { SEOProps } from "../config/seo";

interface Props extends SEOProps {
  showFooter?: boolean;
}

const { showFooter = true, ...seoProps } = Astro.props;
---

<!doctype html>
<html
  lang={seoProps.locale || "es_MX"}
  class="h-full antialiased"
>
  <head>
    <!-- Componente SEO universal con Open Graph, Twitter Cards y Schemas -->
    <SEO {...seoProps} />
    <slot name="head" />
  </head>
  <body
    class="min-h-full flex flex-col bg-primary text-ultra-dark selection:bg-dark-accent selection:text-white"
  >
    <Header />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp siempre accesible -->
    <WhatsAppButton />

    {showFooter && <Footer />}
  </body>
</html>
